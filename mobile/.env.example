# Required for the contact's live-map and crash-alert screens on Android.
# Without this, react-native-maps crashes with:
#   java.lang.IllegalStateException: API key not found...
# See ../docs/google-maps-setup.md for how to get one.
GOOGLE_MAPS_API_KEY_ANDROID=

# Only needed if you also build for iOS.
GOOGLE_MAPS_API_KEY_IOS=
