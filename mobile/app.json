{
  "expo": {
    "name": "BimaRide AI",
    "slug": "bimaride-ai",
    "scheme": "bimaride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BimaRide AI needs your location while riding to score your trip and detect events.",
        "NSMotionUsageDescription": "BimaRide AI uses motion sensors to detect harsh braking, cornering, and crashes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BimaRide AI needs your location while riding to score your trip and detect events."
        }
      ],
      "expo-secure-store"
    ]
  }
}
